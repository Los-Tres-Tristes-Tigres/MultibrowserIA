# Supply at least one provider key. Secrets never enter a workspace or the UI.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional. Defaults to ~/Orbit Workspaces using the operating system home folder.
# ORBIT_WORKSPACES_DIR=
# PORT=4173
# ORBIT_BROWSER_CHANNEL=chrome
# ORBIT_BROWSER_EXECUTABLE_PATH=
# ORBIT_MAX_STEPS=30

# Docker only. Without VNC_PASSWORD a random viewer password is stored in the data volume.
# VNC_PASSWORD=
# TZ=America/Lima
